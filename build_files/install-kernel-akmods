#!/usr/bin/bash

set -eoux pipefail

echo "::group::Executing install-kernel-akmods"
trap 'echo "::endgroup::"' EXIT

# Create shims to bypass kernel-install triggering dracut/rpm-ostree during
# the package transaction (same trick used by ublue-os/bazzite's own kernel
# swap). The initramfs is built explicitly at the end of this script instead.
pushd /usr/lib/kernel/install.d
mv 05-rpmostree.install 05-rpmostree.install.bak
mv 50-dracut.install 50-dracut.install.bak
printf '%s\n' '#!/bin/sh' 'exit 0' >05-rpmostree.install
printf '%s\n' '#!/bin/sh' 'exit 0' >50-dracut.install
chmod +x 05-rpmostree.install 50-dracut.install
popd

# Remove Fedora's stock kernel
for pkg in kernel kernel{-core,-modules,-modules-core,-modules-extra,-tools-libs,-tools}; do
    rpm --erase "${pkg}" --nodeps || true
done

# cleanup leftovers that are not covered by kernel-* packages
rm -rf /usr/lib/modules

# Install the OGC kernel from the prebuilt RPMs mounted in from the akmods image
dnf5 -y install \
    /tmp/kernel-rpms/kernel-[0-9]*.rpm \
    /tmp/kernel-rpms/kernel-core-*.rpm \
    /tmp/kernel-rpms/kernel-modules-*.rpm \
    /tmp/kernel-rpms/kernel-devel-*.rpm

# Keep dnf from ever trying to "helpfully" pull in Fedora's stock kernel again
dnf5 versionlock add kernel kernel-devel kernel-devel-matched kernel-core kernel-modules

# Prebuilt kmods (Xbox controller driver). Uncomment more lines below to pull
# in additional prebuilt kmods bundled in the same akmods/akmods-extra images
# -- see https://github.com/ublue-os/kernel-cache for what's available.
/ctx/install-kmods \
    /tmp/rpms/{common,kmods}/*xone*.rpm
# /tmp/rpms/{common,kmods}/*v4l2loopback*.rpm \
# /tmp/rpms/{common,kmods}/*openrazer*.rpm \
# /tmp/rpms/{common,kmods}/*wl*.rpm

# /ctx/install-kmods \
#     /tmp/rpms/{extra,kmods-extra}/*evdi*.rpm \
#     /tmp/rpms/{extra,kmods-extra}/*ryzen_smu*.rpm \
#     /tmp/rpms/{extra,kmods-extra}/*zenergy*.rpm

pushd /usr/lib/kernel/install.d
mv -f 05-rpmostree.install.bak 05-rpmostree.install
mv -f 50-dracut.install.bak 50-dracut.install
popd

# bootc does NOT generate the initramfs at deploy time: it boots the one shipped
# in the image, so we must build it here (the dracut hook was shimmed above).
# --no-hostonly so it works on any hardware/VM; the ostree module is required
# to mount the deployment root.
KERNEL_VERSION="$(rpm -q kernel-core --queryformat '%{VERSION}-%{RELEASE}.%{ARCH}')"
export DRACUT_NO_XATTR=1
/usr/bin/dracut --no-hostonly --kver "${KERNEL_VERSION}" --reproducible -v --add ostree \
    -f "/usr/lib/modules/${KERNEL_VERSION}/initramfs.img"
chmod 0600 "/usr/lib/modules/${KERNEL_VERSION}/initramfs.img"
