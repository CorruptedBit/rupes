# DE-specific parameters -- set these in the sway/gnome flavor branch, not
# on core. On core itself, every key below must still be *present* (even
# empty): the Justfile's `env("...")` calls error out on every recipe, not
# just `build`, if a key is missing entirely from the loaded dotenv.

# output image name -- each DE flavor publishes to its own GHCR package
# (e.g. "rupes" for sway, "rupes-gnome" for gnome) so they never collide.
IMAGE_NAME=

IMAGE_DESC=
IMAGE_KEYWORDS=

# Bumped by hand on a "substantial change" made directly on this flavor
# branch (not inherited from core -- see README.md's tagging scheme).
BRANCH_VERSION=
