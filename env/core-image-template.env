# Parameters shared by every DE flavor branch (sway, gnome, ...). Edit here,
# then `git merge core` into each flavor branch to propagate.
#
# DE-specific parameters (IMAGE_NAME, IMAGE_DESC, IMAGE_KEYWORDS,
# BRANCH_VERSION) live in env/branch-image-template.env instead -- see
# README.md's "Branches and commit conventions" / "Image tagging scheme".
#
# FEDORA_VERSION is NOT defined here: it's read straight from the
# `ARG FEDORA_VERSION` line in the Containerfile (also a core-owned file),
# so there's a single source of truth instead of two to keep in sync.

# Make this the same as your github username/organisation
REPO_ORGANIZATION="corruptedbit"

# Put your own image here for a fancy profile on https://artifacthub.io/!
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
DEFAULT_TAG="latest"

# Bumped by hand on a "substantial change" made on core (see README.md).
# After the bump, `git merge core` carries the new value into every flavor
# branch automatically -- no need to bump it again there.
CORE_VERSION="2"

BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
