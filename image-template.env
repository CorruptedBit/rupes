# Here we set a bunch of parameters for your image build

# output image name, usually same as repo name, change as needed.
# Left blank on core: it's DE-specific (set in the sway/gnome flavor branch).
# Must still be *present* (even empty) -- the Justfile's `env("IMAGE_NAME")`
# errors on every recipe, not just `build`, if the key is missing entirely.
IMAGE_NAME=

# Make this the same as your github username/organisation
REPO_ORGANIZATION="corruptedbit"

# IMAGE_DESC/IMAGE_KEYWORDS are DE-specific: set them in the sway/gnome
# flavor branch, not here.
IMAGE_DESC="Fedora Atomic with the OGC gaming kernel swapped in, plus opinionated dev tooling."
IMAGE_KEYWORDS="bootc,oci,linux,gaming,steam,ogc"

# Put your own image here for a fancy profile on https://artifacthub.io/!
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
DEFAULT_TAG="latest"

# "x" in the rupes:<fedora-major>.x.y tagging scheme (see README.md).
# Bump manually on substantial changes; reset to 0 on a Fedora major bump.
VERSION_MINOR="1"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
